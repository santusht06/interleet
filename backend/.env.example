# ──────────────────────────────────────────────────────────────────
# InterLeet Backend — Environment Template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# See docs/DEPLOYMENT.md for the full reference.
# ──────────────────────────────────────────────────────────────────

# Environment: DEVELOPMENT | PRODUCTION
# In PRODUCTION the app fails to boot without SESSION_SECRET_KEY, forces secure
# cookies, and disables mock/free-premium payments.
PROJECT_ENVIRONMENT=DEVELOPMENT

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
MONGO_URI=mongodb://localhost:27017
DB_NAME=interleet

# Redis (queue + cache + interview sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_QUEUE_KEY=interleet:execution_jobs

# Sessions / cookies
SESSION_SECRET_KEY=            # REQUIRED in production (random 32+ byte string)

# JWT — asymmetric RS256. Generate the keypair (see docs/DEVELOPMENT.md):
#   openssl genpkey -algorithm RSA -out app/core/security/private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in app/core/security/private.pem -pubout -out app/core/security/public.pem
JWT_SECRET=                    # legacy/unused when using PEM keys; set if referenced
JWT_ALGORITHM=RS256
JWT_EXPIRES=7                  # days

# Admin access (replaces the old hardcoded backdoor).
# BOTH must be set for POST /auth/admin/login to work — fails closed if empty.
ADMIN_EMAILS=                  # comma-separated allowlist, e.g. admin@interleet.in
ADMIN_LOGIN_CODE=             # strong secret code (NOT a 4-digit pin)

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM providers (at least one required; GROQ matches the defaults)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
OPENAI_API_KEY=               # also used for interview TTS
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Interview sessions
INTERVIEW_SESSION_TTL_SECONDS=21600   # 6h

# Cloudinary (resume uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (OTP + notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Interleet

# Payments (Razorpay). If unset in PRODUCTION, payment endpoints fail closed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Execution engine
WORKER_COUNT=4
EXECUTION_WORKSPACE_DIR=/tmp/interleet_workspaces

# Pinecone (unused/scaffold — safe to leave blank)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=face-embeddings
